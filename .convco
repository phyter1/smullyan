# convco configuration — https://convco.github.io
# Verified against convco 0.7.1. Keys are camelCase; the file is YAML despite
# having no extension. convco falls back to .versionrc if this file is absent.
#
# Consumed by:
#   commit-msg  ->  convco check --from-stdin --strip
#   pre-push    ->  convco check origin/main..HEAD
#
# Version bumping is owned by Changesets, NOT by `convco version`. The types
# below exist to constrain what a commit message may SAY. The `section` values
# only matter if someone runs `convco changelog` locally; CHANGELOG.md is
# generated by Changesets.

types:
  - type: feat
    section: Features
  - type: fix
    section: Bug Fixes
  - type: perf
    section: Performance
  - type: revert
    section: Reverts
  - type: docs
    section: Documentation
  - type: refactor
    section: Refactoring
  - type: types
    section: Types
  - type: test
    section: Other
    hidden: true
  - type: build
    section: Other
    hidden: true
  - type: ci
    section: Other
    hidden: true
  - type: chore
    section: Other
    hidden: true
  - type: style
    section: Other
    hidden: true

# The scope set is closed on purpose: these are the package's entry points plus
# a handful of infrastructure scopes. A typo'd scope should fail the hook rather
# than silently invent a new changelog group.
scopeRegex: "^(birds|option|result|task|reader|pipe|core|types|deps|ci|build|release|repo)$"

# Applies to `convco commit` (the interactive helper), not to `convco check`.
# Subject length in the commit-msg hook is enforced by the commit-msg-style job
# in lefthook.yml, which is where the 72-character rule actually bites.
description:
  length:
    min: 10
    max: 72
