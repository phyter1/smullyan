# Dependencies
node_modules/
.pnpm-store/

# Build output. The published artefact is generated; committing it guarantees it
# will eventually be stale.
dist/
*.tsbuildinfo

# Test and coverage output. CI regenerates these; the 100% gate reads them.
coverage/
.vitest-reports/
*.lcov

# Packaging
*.tgz

# Machine-local hook overrides. lefthook merges these on top of lefthook.yml,
# which is exactly why they must never be shared.
lefthook-local.yml
lefthook-local.yaml

# Secrets. Nothing in this repository needs any, which is precisely why an
# accidental one must not be committable.
.env
.env.*
!.env.example

# Editors and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Generated by `pnpm check:dts-emit` — the tsc declaration reference build.
.types-reference/

# VitePress build output and cache.
docs/.vitepress/dist/
docs/.vitepress/cache/
