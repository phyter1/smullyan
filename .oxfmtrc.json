{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "objectWrap": "preserve",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "embeddedLanguageFormatting": "auto",
  "proseWrap": "preserve",
  "sortImports": {
    "groups": ["type", "builtin", "external", "internal", "parent", "sibling", "index"],
    "newlinesBetween": true,
    "order": "asc",
    "ignoreCase": true,
    "sortSideEffects": false
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist/",
    "coverage/",
    "node_modules/",
    "CHANGELOG.md",
    ".changeset/",
    ".types-reference/"
  ]
}
